<Window x:Class="Misearch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Misearch" Height="820" Width="1280" MinHeight="540" MinWidth="900"
        Icon="pack://application:,,,/Assets/misearch.ico" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="54" />
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- Barra de título -->
        <Border Grid.Row="0" Background="{StaticResource BgBrush}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid Margin="10,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="BrandImage" Width="28" Height="28"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="M" FontFamily="Segoe UI Black" FontSize="16" LineHeight="16"
                                   LineStackingStrategy="BlockLineHeight" />
                        <TextBlock Text="isearch" FontSize="8.5" Margin="1,1,0,0" Foreground="#A6B1C4" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Margin="10,0,0,0" Padding="8,3" CornerRadius="6"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                        BorderThickness="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="SIN RASTREO" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimizar" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximizar" />
                    <Button Style="{StaticResource CloseTitleButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Cerrar" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Barra de herramientas -->
        <Border Grid.Row="1" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="0,0,0,1" Padding="10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" Click="Back_Click" ToolTip="Atrás (Alt+Izquierda)" />
                    <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Content="&#xE72A;" Click="Forward_Click" ToolTip="Adelante (Alt+Derecha)" />
                    <Button x:Name="ReloadButton" Style="{StaticResource IconButton}" Content="&#xE72C;" Click="Reload_Click" ToolTip="Recargar (F5)" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE80F;" Click="Home_Click" ToolTip="Nueva pestaña" />
                </StackPanel>

                <Border Grid.Column="1" Height="38" Margin="8,0" VerticalAlignment="Center"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                        BorderThickness="1" CornerRadius="10">
                    <Grid Margin="10,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SecurityIcon" Grid.Column="0" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <Grid Grid.Column="1" Margin="8,0">
                            <TextBox x:Name="AddressBox" Style="{StaticResource FlatTextBox}" KeyDown="AddressBox_KeyDown"
                                     GotFocus="AddressBox_GotFocus" LostFocus="AddressBox_LostFocus"
                                     BorderThickness="0" />
                            <TextBlock x:Name="AddressPlaceholder" Text="Busca en DuckDuckGo o escribe una dirección"
                                       FontSize="13" Foreground="#5B667A" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                        <Button x:Name="StarButton" Grid.Column="2" Style="{StaticResource IconButton}" Width="28" Height="28"
                                FontSize="12" Content="&#xE734;" Click="Star_Click" ToolTip="Añadir a marcadores" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="VpnPill" Style="{StaticResource SecondaryButton}" Padding="10,6" Margin="2,0,2,0"
                            Click="VpnPill_Click" ToolTip="Estado de la VPN" AutomationProperties.Name="VPN">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="VpnDot" Width="7" Height="7" Fill="{StaticResource MutedBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="VpnPillText" Text="VPN" FontSize="11.5" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ShieldButton" Style="{StaticResource IconButton}" Content="&#xEA18;"
                            Click="Shield_Click" ToolTip="Privacidad y bloqueos" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE749;" Click="Print_Click" ToolTip="Imprimir (Ctrl+P)" AutomationProperties.Name="Imprimir" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE896;" Click="OpenDownloads_Click" ToolTip="Descargas" />
                    <Button x:Name="MenuButton" Style="{StaticResource IconButton}" Content="&#xE712;" Click="Menu_Click" ToolTip="Menú" AutomationProperties.Name="Menú" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Pestañas -->
        <Border Grid.Row="2" Background="{StaticResource BgBrush}">
            <Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="10,0">
                    <StackPanel x:Name="TabsPanel" Orientation="Horizontal" VerticalAlignment="Bottom" />
                </ScrollViewer>
                <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="11"
                        Content="&#xE710;" HorizontalAlignment="Left" Margin="0,0,0,0" Visibility="Collapsed"
                        Click="NewTab_Click" />
            </Grid>
        </Border>

        <!-- Contenido -->
        <Grid Grid.Row="3" Background="{StaticResource BgBrush}" ClipToBounds="True">
            <Grid x:Name="ViewsHost" />

            <Border x:Name="SidePanel" Width="400" HorizontalAlignment="Right" Margin="0,0,10,10"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="1" CornerRadius="14" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.45" Color="Black" />
                </Border.Effect>
                <Grid Margin="16,14,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PanelIcon" Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="PanelTitleText" Text="Privacidad" Style="{StaticResource PanelTitle}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11"
                                Content="&#xE711;" Click="PanelClose_Click" ToolTip="Cerrar" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <Grid>
                            <!-- Menú -->
                            <StackPanel x:Name="PanelHome">
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="NAVEGACIÓN" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,8" />
                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" HorizontalContentAlignment="Left" Click="OpenHistory_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                            <TextBlock Text="Historial" Margin="10,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" HorizontalContentAlignment="Left" Click="OpenBookmarks_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                            <TextBlock Text="Marcadores" Margin="10,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" HorizontalContentAlignment="Left" Click="OpenDownloads_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                            <TextBlock Text="Descargas" Margin="10,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" HorizontalContentAlignment="Left" Click="OpenPdf_Click" AutomationProperties.Name="Abrir PDF">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                            <TextBlock Text="Abrir PDF" Margin="10,0,0,0" />
                                            <TextBlock Text="Ctrl+O" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" HorizontalContentAlignment="Left" Click="Print_Click" AutomationProperties.Name="Imprimir">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                            <TextBlock Text="Imprimir" Margin="10,0,0,0" />
                                            <TextBlock Text="Ctrl+P" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <StackPanel Margin="0,8,0,6">
                                    <TextBlock Text="SEGURIDAD" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,8" />
                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" HorizontalContentAlignment="Left" Click="OpenVpn_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                            <TextBlock Text="VPN y perfiles" Margin="10,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" HorizontalContentAlignment="Left" Click="OpenSettings_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                            <TextBlock Text="Ajustes" Margin="10,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Protección activa" FontWeight="SemiBold" FontSize="12.5" />
                                        <TextBlock x:Name="HomeProtectionText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Misearch 0.1.2 · © 2026 MSoft" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,14,0,2" />
                                <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource AccentBrush}" Cursor="Hand"
                                           Text="Diseñado por MSoft · msoft.com.es" MouseLeftButtonUp="OpenMsoft_Click" />
                            </StackPanel>

                            <!-- Ajustes -->
                            <StackPanel x:Name="PanelSettings" Visibility="Collapsed">
                                <TextBlock Text="MOTOR DE BÚSQUEDA" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,8" />
                                <WrapPanel x:Name="EngineChips" Margin="0,0,0,4">
                                    <Button Style="{StaticResource Chip}" Tag="DuckDuckGo" Content="DuckDuckGo" Click="Engine_Click" />
                                    <Button Style="{StaticResource Chip}" Tag="Google" Content="Google" Click="Engine_Click" />
                                    <Button Style="{StaticResource Chip}" Tag="Bing" Content="Bing" Click="Engine_Click" />
                                    <Button Style="{StaticResource Chip}" Tag="Startpage" Content="Startpage" Click="Engine_Click" />
                                    <Button Style="{StaticResource Chip}" Tag="Brave" Content="Brave" Click="Engine_Click" />
                                </WrapPanel>
                                <TextBlock x:Name="EngineHint" Style="{StaticResource MutedText}" Margin="2,4,0,16" TextWrapping="Wrap" />

                                <TextBlock Text="PRIVACIDAD" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,10" />
                                <CheckBox x:Name="BlockTrackersCheck" Style="{StaticResource DarkCheck}" Content="Bloquear rastreadores y anuncios" Margin="0,0,0,12" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                <CheckBox x:Name="PrivateModeCheck" Style="{StaticResource DarkCheck}" Content="Modo privado (sin cookies persistentes)" Margin="0,0,0,12" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                <CheckBox x:Name="ClearExitCheck" Style="{StaticResource DarkCheck}" Content="Borrar datos al cerrar" Margin="0,0,0,12" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                <CheckBox x:Name="HttpsFirstCheck" Style="{StaticResource DarkCheck}" Content="Intentar HTTPS primero" Margin="0,0,0,12" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                <TextBlock x:Name="PrivateHint" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,14" />

                                <Button Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Click="ClearData_Click" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                        <TextBlock Text="Borrar historial y marcadores" Margin="10,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Click="OpenDownloadFolder_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                        <TextBlock Text="Abrir carpeta de descargas" Margin="10,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- VPN -->
                            <StackPanel x:Name="PanelVpn" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="VpnStateDot" Width="9" Height="9" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="VpnStateText" Text="VPN desactivada" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="VpnDetailText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,7,0,0" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="PERFIL" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,8" />
                                <TextBlock x:Name="VpnProfileText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="2,0,0,10" />
                                <Button Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="ImportWireGuard_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                        <TextBlock Text="Importar WireGuard (.conf)" Margin="10,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,12" Click="ImportClash_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                        <TextBlock Text="Importar Clash / suscripción (.yaml)" Margin="10,0,0,0" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="VpnActionButton" Style="{StaticResource PrimaryButton}" Content="Activar VPN" Margin="0,0,0,14" Click="VpnAction_Click" />

                                <TextBlock Text="MOTOR" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,8" />
                                <TextBlock x:Name="EngineText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="2,0,0,8" />
                                <Button x:Name="DownloadEngineButton" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,10" Click="DownloadEngine_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                        <TextBlock Text="Descargar motor Mihomo" Margin="10,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="EngineProgressText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="2,0,0,6" />
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="2,8,0,0">
                                    Misearch crea un túnel privado solo para este navegador. Si el motor se cae, el tráfico queda bloqueado (kill switch).
                                </TextBlock>
                                <TextBlock Margin="2,8,0,0" FontSize="11.5" Foreground="{StaticResource AccentBrush}" Cursor="Hand"
                                           Text="Motor Mihomo · código abierto (GPL-3.0)"
                                           MouseLeftButtonUp="OpenMihomoSource_Click" />
                            </StackPanel>

                            <!-- Historial -->
                            <StackPanel x:Name="PanelHistory" Visibility="Collapsed">
                                <TextBox x:Name="HistorySearchBox" Style="{StaticResource FlatTextBox}" Height="34"
                                         Background="{StaticResource Surface2Brush}" Padding="10,0"
                                         TextChanged="HistorySearch_TextChanged" />
                                <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0"
                                         Margin="0,10,0,0" MaxHeight="520" MouseDoubleClick="HistoryList_MouseDoubleClick" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Borrar historial" Margin="0,12,0,0" Click="ClearHistory_Click" />
                            </StackPanel>

                            <!-- Marcadores -->
                            <StackPanel x:Name="PanelBookmarks" Visibility="Collapsed">
                                <ListBox x:Name="BookmarksList" Background="Transparent" BorderThickness="0"
                                         MaxHeight="540" MouseDoubleClick="BookmarksList_MouseDoubleClick" />
                                <TextBlock x:Name="BookmarksEmpty" Style="{StaticResource MutedText}" Text="Aún no tienes marcadores. Pulsa la estrella en la barra de direcciones." TextWrapping="Wrap" Margin="2,8,0,0" />
                            </StackPanel>

                            <!-- Descargas -->
                            <StackPanel x:Name="PanelDownloads" Visibility="Collapsed">
                                <ListBox x:Name="DownloadsList" Background="Transparent" BorderThickness="0" MaxHeight="520" />
                                <TextBlock x:Name="DownloadsEmpty" Style="{StaticResource MutedText}" Text="No hay descargas en esta sesión." Margin="2,8,0,0" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Abrir carpeta de descargas" Margin="0,12,0,0" Click="OpenDownloadFolder_Click" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"
                    Background="#E6141D2E" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                    CornerRadius="10" Padding="14,9" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="ToastText" FontSize="12.5" />
            </Border>
        </Grid>

        <!-- Barra de estado -->
        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="0,1,0,0" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusSecurityDot" Width="7" Height="7" Fill="{StaticResource GreenBrush}" />
                    <TextBlock x:Name="StatusSecurityText" Text="Listo" Style="{StaticResource MutedText}" Margin="7,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusBlockedText" Text="0 bloqueados" Style="{StaticResource MutedText}" Margin="6,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusVpnText" Text="VPN desactivada" Style="{StaticResource MutedText}" Margin="0,0,14,0" />
                    <TextBlock Text="Misearch 0.1.2" Style="{StaticResource MutedText}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
